                Padding: (Left: 12, Right: 4, Top: 6, Bottom: 4);

                Label #ManaLabel {
                  Text: "Mana";
                  Style: (FontSize: 13, TextColor: #5aa9ff, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 112, Height: 22);
                }
                Label #ManaValue {
                  Text: "0";
                  Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 112, Height: 34);
                }
                Label #ManaDelta {
                  Text: "";
                  Style: (FontSize: 12, TextColor: #ffd166, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 112, Height: 20);
                }
              }

              Group #ManaControls {
                LayoutMode: Top;
                Anchor: (Width: 126, Height: 92);

                Group { Anchor: (Width: 126, Height: 26); }

                Group #ManaButtons {
                  LayoutMode: Left;
                  Anchor: (Width: 126, Height: 40);

                  TextButton #ManaMinusBtn {
                    Anchor: (Width: 56, Height: 40);
                    Text: "-";
                    Style: $C.@DefaultTextButtonStyle;
                  }
                  Group #ManaMinusOff {
                    Visible: false;
                    Anchor: (Width: 56, Height: 40);
                    Background: #24214d(0.9);
                    Label #ManaMinusOffText {
                      Text: "-";
                      Style: (FontSize: 16, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                      Anchor: (Width: 56, Height: 40);
                    }
                  }
                  Group #ManaButtonGap {
                    Anchor: (Width: 8, Height: 40);
                  }
                  TextButton #ManaBtn {
                    Anchor: (Width: 56, Height: 40);
                    Text: "+";
                    Style: $C.@DefaultTextButtonStyle;
                  }
                  Group #ManaPlusOff {
                    Visible: false;
                    Anchor: (Width: 56, Height: 40);
                    Background: #24214d(0.9);
                    Label #ManaPlusOffText {
                      Text: "+";
                      Style: (FontSize: 16, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                      Anchor: (Width: 56, Height: 40);
                    }
                  }
                }
              }
            }
          }
          }
          Group { Anchor: (Width: 10, Height: 8); }
          Group {
            LayoutMode: Left;
            Anchor: (Width: 532, Height: 92);

          Group #DamageCard {
            LayoutMode: Left;
            Anchor: (Width: 259, Height: 92);
            Background: #1b1842(0.97);

            Group #DamageAccent {
              Anchor: (Width: 5, Height: 92);
              Background: #ffb454;
            }

            Group #DamageBody {
              LayoutMode: Left;
              Anchor: (Width: 254, Height: 92);

              Group #DamageText {
                LayoutMode: Top;
                Anchor: (Width: 128, Height: 92);
                Padding: (Left: 12, Right: 4, Top: 6, Bottom: 4);

                Label #DamageLabel {
                  Text: "Damage";
                  Style: (FontSize: 13, TextColor: #ffb454, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
