                Group { Anchor: (Width: 126, Height: 26); }

                Group #SpeedButtons {
                  LayoutMode: Left;
                  Anchor: (Width: 126, Height: 40);

                  TextButton #SpeedMinusBtn {
                    Anchor: (Width: 56, Height: 40);
                    Text: "-";
                    Style: $C.@DefaultTextButtonStyle;
                  }
                  Group #SpeedMinusOff {
                    Visible: false;
