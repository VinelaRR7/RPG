          }
          Group { Anchor: (Width: 10, Height: 8); }
          Group {
            LayoutMode: Left;
            Anchor: (Width: 532, Height: 92);

          Group #StaminaCard {
            LayoutMode: Left;
            Anchor: (Width: 259, Height: 92);
            Background: #1b1842(0.97);

