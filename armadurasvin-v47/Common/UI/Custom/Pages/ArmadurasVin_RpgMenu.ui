                    Label #SpeedMinusOffText {
                      Text: "-";
                      Style: (FontSize: 16, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                      Anchor: (Width: 56, Height: 40);
                    }
                  }
                  Group #SpeedButtonGap {
                    Anchor: (Width: 8, Height: 40);
                  }
                  TextButton #SpeedBtn {
                    Anchor: (Width: 56, Height: 40);
                    Text: "+";
                    Style: $C.@DefaultTextButtonStyle;
                  }
                  Group #SpeedPlusOff {
                    Visible: false;
                    Anchor: (Width: 56, Height: 40);
                    Background: #24214d(0.9);
                    Label #SpeedPlusOffText {
                      Text: "+";
                      Style: (FontSize: 16, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                      Anchor: (Width: 56, Height: 40);
                    }
                  }
                }
              }
            }
          }
          }
          }

          Group { Anchor: (Width: 10, Height: 10); }

          Group #PrestigePanel {
            LayoutMode: Top;
            Anchor: (Width: 560, Height: 215);
            Background: #0f0d24(0.95);
            Padding: (Left: 14, Right: 14, Top: 12, Bottom: 12);

          Label #PrestigeHeading {
            Text: "Prestigio - Bonos permanentes";
            Style: (FontSize: 14, TextColor: #f5c26b, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            Anchor: (Width: 532, Height: 26);
          }
          Group { Anchor: (Width: 532, Height: 1); Background: #8a6d2f(0.95); }
          Group { Anchor: (Width: 10, Height: 8); }
          Group {
            LayoutMode: Left;
            Anchor: (Width: 532, Height: 46);

            Group #PrestigeHealthCell {
              LayoutMode: Left;
              Anchor: (Width: 168, Height: 46);
              Background: #1b1842(0.97);

              Group { Anchor: (Width: 4, Height: 46); Background: #ff6b6b; }
              Group #PrestigeHealthBody {
                LayoutMode: Top;
                Anchor: (Width: 164, Height: 46);
                Padding: (Left: 10, Right: 4, Top: 3, Bottom: 3);

                Label #PrestigeHealthBonusLabel {
                  Text: "Vida";
                  Style: (FontSize: 11, TextColor: #b9b0dd, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 16);
                }
                Label #PrestigeHealthBonus {
                  Text: "--";
                  Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 24);
                }
              }
            }
            Group { Anchor: (Width: 14, Height: 46); }
            Group #PrestigeManaCell {
              LayoutMode: Left;
              Anchor: (Width: 168, Height: 46);
              Background: #1b1842(0.97);

              Group { Anchor: (Width: 4, Height: 46); Background: #5aa9ff; }
              Group #PrestigeManaBody {
                LayoutMode: Top;
                Anchor: (Width: 164, Height: 46);
                Padding: (Left: 10, Right: 4, Top: 3, Bottom: 3);

                Label #PrestigeManaBonusLabel {
                  Text: "Mana";
                  Style: (FontSize: 11, TextColor: #b9b0dd, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 16);
                }
                Label #PrestigeManaBonus {
                  Text: "--";
                  Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 24);
                }
              }
            }
            Group { Anchor: (Width: 14, Height: 46); }
            Group #PrestigeDamageCell {
              LayoutMode: Left;
              Anchor: (Width: 168, Height: 46);
              Background: #1b1842(0.97);

              Group { Anchor: (Width: 4, Height: 46); Background: #ffb454; }
              Group #PrestigeDamageBody {
                LayoutMode: Top;
                Anchor: (Width: 164, Height: 46);
                Padding: (Left: 10, Right: 4, Top: 3, Bottom: 3);

                Label #PrestigeDamageBonusLabel {
                  Text: "Dano";
                  Style: (FontSize: 11, TextColor: #b9b0dd, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 16);
                }
                Label #PrestigeDamageBonus {
                  Text: "--";
                  Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 24);
                }
              }
            }
          }
          Group { Anchor: (Width: 10, Height: 8); }
          Group {
            LayoutMode: Left;
            Anchor: (Width: 532, Height: 46);

            Group #PrestigeDefenseCell {
              LayoutMode: Left;
              Anchor: (Width: 168, Height: 46);
              Background: #1b1842(0.97);

              Group { Anchor: (Width: 4, Height: 46); Background: #4fd1a1; }
              Group #PrestigeDefenseBody {
                LayoutMode: Top;
                Anchor: (Width: 164, Height: 46);
                Padding: (Left: 10, Right: 4, Top: 3, Bottom: 3);

                Label #PrestigeDefenseBonusLabel {
                  Text: "Defensa";
                  Style: (FontSize: 11, TextColor: #b9b0dd, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 16);
                }
                Label #PrestigeDefenseBonus {
                  Text: "--";
                  Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 24);
                }
              }
            }
            Group { Anchor: (Width: 14, Height: 46); }
            Group #PrestigeStaminaCell {
              LayoutMode: Left;
              Anchor: (Width: 168, Height: 46);
              Background: #1b1842(0.97);

              Group { Anchor: (Width: 4, Height: 46); Background: #9be564; }
              Group #PrestigeStaminaBody {
                LayoutMode: Top;
                Anchor: (Width: 164, Height: 46);
                Padding: (Left: 10, Right: 4, Top: 3, Bottom: 3);

                Label #PrestigeStaminaBonusLabel {
                  Text: "Vigor";
                  Style: (FontSize: 11, TextColor: #b9b0dd, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 16);
                }
                Label #PrestigeStaminaBonus {
                  Text: "--";
                  Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 24);
                }
              }
            }
            Group { Anchor: (Width: 14, Height: 46); }
            Group #PrestigeSpeedCell {
              LayoutMode: Left;
              Anchor: (Width: 168, Height: 46);
              Background: #1b1842(0.97);

              Group { Anchor: (Width: 4, Height: 46); Background: #c792ff; }
              Group #PrestigeSpeedBody {
                LayoutMode: Top;
                Anchor: (Width: 164, Height: 46);
                Padding: (Left: 10, Right: 4, Top: 3, Bottom: 3);

                Label #PrestigeSpeedBonusLabel {
                  Text: "Velocidad";
                  Style: (FontSize: 11, TextColor: #b9b0dd, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 16);
                }
                Label #PrestigeSpeedBonus {
                  Text: "--";
                  Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 148, Height: 24);
                }
              }
            }
          }
          Group { Anchor: (Width: 10, Height: 8); }
          Label #PrestigeNote {
            Text: "Al llegar al nivel requerido (20, 30, 40...) usa /rpgprestigio: vuelves a nivel 1, conservas tu clase y reinicias tus puntos. Cada Prestigio otorga un bono permanente del 5% de tu progresion.";
            Style: (FontSize: 11, TextColor: #b9b0dd, Wrap: true);
            Anchor: (Width: 532, Height: 44);
          }
          }
        }
      }

      // Textos decorativos del Java: ids conservados, ocultos y sin ocupar espacio.
      Label #DividerTop {
        Visible: false;
        Text: "";
        Style: (FontSize: 11, TextColor: #8f7ae0, HorizontalAlignment: Center);
        Anchor: (Width: 872, Height: 1);
      }

      Group { Anchor: (Width: 872, Height: 10); }

      // ================= Barra inferior: ayuda + acciones =================
      Group #ActionsRow {
        LayoutMode: Left;
        Anchor: (Width: 872, Height: 44);

        Label #FooterHint {
          Text: "";
          Style: (FontSize: 11, TextColor: #b9b0dd, Wrap: true, VerticalAlignment: Center);
          Anchor: (Width: 496, Height: 44);
        }

        TextButton #CancelBtn {
          Anchor: (Width: 180, Height: 42);
          Text: "Cancelar";
          Style: $C.@DefaultTextButtonStyle;
        }
        Group #CancelOff {
          Visible: false;
          Anchor: (Width: 180, Height: 42);
          Background: #24214d(0.9);
          Label #CancelOffText {
            Text: "Cancelar";
            Style: (FontSize: 14, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Anchor: (Width: 180, Height: 42);
          }
        }

        Group #ActionsGap {
          Anchor: (Width: 12, Height: 42);
        }

        TextButton #ConfirmBtn {
          Anchor: (Width: 180, Height: 42);
          Text: "Confirmar";
          Style: $C.@DefaultTextButtonStyle;
        }
        Group #ConfirmOff {
          Visible: false;
          Anchor: (Width: 180, Height: 42);
          Background: #24214d(0.9);
          Label #ConfirmOffText {
            Text: "Confirmar";
            Style: (FontSize: 14, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Anchor: (Width: 180, Height: 42);
          }
        }
      }

      Label #DividerBottom {
        Visible: false;
        Text: "";
        Style: (FontSize: 11, TextColor: #8f7ae0, HorizontalAlignment: Center);
        Anchor: (Width: 872, Height: 1);
      }
    }
  }
}

$C.@BackButton {}
