          Group #SpeedCard {
            LayoutMode: Left;
            Anchor: (Width: 259, Height: 92);
            Background: #1b1842(0.97);

            Group #SpeedAccent {
              Anchor: (Width: 5, Height: 92);
              Background: #c792ff;
            }

            Group #SpeedBody {
