$C = "../Common.ui";

// ArmadurasVin RPG menu v47 - layout de tamano fijo + panel de Prestigio.
// - Cada elemento declara Width y Height; sin FlexWeight ni margenes que dependan del contenido.
// - Los pares boton / *Off miden exactamente lo mismo: alternar Visible no mueve nada.
// - HorizontalAlignment / VerticalAlignment solo con Start, Center o End (nunca Right).
// - Se conservan todos los ids que el Java lee o actualiza.
//
// Ids de Prestigio (el Java actual NO los rellena todavia; muestran "--" hasta que RpgMenuPage los envie):
//   #PrestigeValue            -> numero de Prestigio        (PlayerRpgData.getPrestige(), int)
//   #PrestigeNextValue        -> nivel requerido siguiente  (PlayerRpgData.prestigeRequirement(), int)
//   #PrestigeHealthBonus, #PrestigeManaBonus, #PrestigeDamageBonus,
//   #PrestigeDefenseBonus, #PrestigeStaminaBonus, #PrestigeSpeedBonus -> bonos permanentes (float)

$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 940, Height: 740);

    #Title {
      Group {
        $C.@Title {
          @Text = "ArmadurasVin - Menu RPG";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 16, Right: 12, Top: 8, Bottom: 10);

      Group #Columns {
        LayoutMode: Left;
        Anchor: (Width: 872, Height: 580);

        // ================= Panel izquierdo: progreso, prestigio y clase =================
        Group #LeftPanel {
          LayoutMode: Top;
          Anchor: (Width: 300, Height: 580);
          Background: #0f0d24(0.95);
          Padding: (Left: 14, Right: 14, Top: 12, Bottom: 12);

          Label #SummaryHeading {
            Text: "Personaje";
            Style: (FontSize: 14, TextColor: #cdbfff, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            Anchor: (Width: 272, Height: 26);
          }
          Group { Anchor: (Width: 272, Height: 1); Background: #4b3f94(0.9); }
          Group { Anchor: (Width: 10, Height: 8); }

          Group #LevelCard {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 30);
            Background: #1b1842(0.97);

            Group { Anchor: (Width: 4, Height: 30); Background: #7a68e0; }
            Group { Anchor: (Width: 8, Height: 30); }
            Label #LevelLabel {
              Text: "Nivel";
              Style: (FontSize: 12, TextColor: #e8e4ff, RenderBold: true, VerticalAlignment: Center);
              Anchor: (Width: 120, Height: 30);
            }
            Label #LevelValue {
              Text: "1";
              Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
              Anchor: (Width: 128, Height: 30);
            }
            Group { Anchor: (Width: 12, Height: 30); }
          }
          Group { Anchor: (Width: 10, Height: 3); }
          Group #PrestigeCard {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 30);
            Background: #1b1842(0.97);

            Group { Anchor: (Width: 4, Height: 30); Background: #f5c26b; }
            Group { Anchor: (Width: 8, Height: 30); }
            Label #PrestigeLabel {
              Text: "Prestigio";
              Style: (FontSize: 12, TextColor: #f5c26b, RenderBold: true, VerticalAlignment: Center);
              Anchor: (Width: 120, Height: 30);
            }
            Label #PrestigeValue {
              Text: "--";
              Style: (FontSize: 15, TextColor: #f5c26b, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
              Anchor: (Width: 128, Height: 30);
            }
            Group { Anchor: (Width: 12, Height: 30); }
          }
          Group { Anchor: (Width: 10, Height: 3); }
          Group #PrestigeNextCard {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 30);
            Background: #1b1842(0.97);

            Group { Anchor: (Width: 4, Height: 30); Background: #f5c26b; }
            Group { Anchor: (Width: 8, Height: 30); }
            Label #PrestigeNextLabel {
              Text: "Proximo prestigio";
              Style: (FontSize: 12, TextColor: #f5c26b, RenderBold: true, VerticalAlignment: Center);
              Anchor: (Width: 120, Height: 30);
            }
            Label #PrestigeNextValue {
              Text: "--";
              Style: (FontSize: 15, TextColor: #f5c26b, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
              Anchor: (Width: 128, Height: 30);
            }
            Group { Anchor: (Width: 12, Height: 30); }
          }
          Group { Anchor: (Width: 10, Height: 3); }
          Group #XpCard {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 30);
            Background: #1b1842(0.97);

            Group { Anchor: (Width: 4, Height: 30); Background: #7a68e0; }
            Group { Anchor: (Width: 8, Height: 30); }
            Label #XpLabel {
              Text: "XP";
              Style: (FontSize: 12, TextColor: #e8e4ff, RenderBold: true, VerticalAlignment: Center);
              Anchor: (Width: 120, Height: 30);
            }
            Label #XpValue {
              Text: "0 / 100";
              Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
              Anchor: (Width: 128, Height: 30);
            }
            Group { Anchor: (Width: 12, Height: 30); }
          }
          Group { Anchor: (Width: 10, Height: 3); }
          Group #PointsCard {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 40);
            Background: #1b1842(0.97);

            Group { Anchor: (Width: 4, Height: 40); Background: #7a68e0; }
            Group { Anchor: (Width: 8, Height: 40); }
            Label #PointsLabel {
              Text: "Puntos disponibles";
              Style: (FontSize: 12, TextColor: #ffd166, RenderBold: true, VerticalAlignment: Center);
              Anchor: (Width: 120, Height: 40);
            }
            Label #PointsValue {
              Text: "0";
              Style: (FontSize: 20, TextColor: #ffd166, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
              Anchor: (Width: 128, Height: 40);
            }
            Group { Anchor: (Width: 12, Height: 40); }
          }
          Group { Anchor: (Width: 10, Height: 3); }
          Label #PointsHint {
            Text: "";
            Style: (FontSize: 11, TextColor: #b9b0dd, Wrap: true);
            Anchor: (Width: 272, Height: 34);
          }

          Label #PendingLabel {
            Text: "";
            Style: (FontSize: 11, TextColor: #ffd166, Wrap: true);
            Anchor: (Width: 272, Height: 44);
          }

          Group { Anchor: (Width: 10, Height: 6); }

          Label #ClassHeading {
            Text: "Clase";
            Style: (FontSize: 14, TextColor: #cdbfff, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            Anchor: (Width: 272, Height: 26);
          }
          Group { Anchor: (Width: 272, Height: 1); Background: #4b3f94(0.9); }
          Group { Anchor: (Width: 10, Height: 8); }
          Label #ClassCurrent {
            Text: "";
            Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
            Anchor: (Width: 272, Height: 22);
          }

          Label #ClassChooseHint {
            Text: "";
            Style: (FontSize: 11, TextColor: #b9b0dd, Wrap: true);
            Anchor: (Width: 272, Height: 34);
          }

          Group { Anchor: (Width: 10, Height: 4); }

          Group #ClassRowA {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 40);

              TextButton #ClassBtn0 {
                Anchor: (Width: 132, Height: 40);
                Text: "Guerrero";
                Style: $C.@DefaultTextButtonStyle;
              }
              Group { Anchor: (Width: 8, Height: 40); }
              TextButton #ClassBtn1 {
                Anchor: (Width: 132, Height: 40);
                Text: "Mago";
                Style: $C.@DefaultTextButtonStyle;
              }
          }

          Group { Anchor: (Width: 10, Height: 6); }

          Group #ClassRowB {
            LayoutMode: Left;
            Anchor: (Width: 272, Height: 40);

              TextButton #ClassBtn2 {
                Anchor: (Width: 132, Height: 40);
                Text: "Arquero";
                Style: $C.@DefaultTextButtonStyle;
              }
              Group { Anchor: (Width: 8, Height: 40); }
              TextButton #ClassBtn3 {
                Anchor: (Width: 132, Height: 40);
                Text: "Asesino";
                Style: $C.@DefaultTextButtonStyle;
              }
          }

          Group { Anchor: (Width: 10, Height: 6); }

          Label #ClassStats {
            Text: "";
            Style: (FontSize: 11, TextColor: #b9b0dd, Wrap: true);
            Anchor: (Width: 272, Height: 66);
          }
        }

        Group #ColumnSpacer {
          Anchor: (Width: 12, Height: 580);
        }

        // ================= Columna derecha: atributos + prestigio =================
        Group #RightColumn {
          LayoutMode: Top;
          Anchor: (Width: 560, Height: 580);

          Group #RightPanel {
            LayoutMode: Top;
            Anchor: (Width: 560, Height: 355);
            Background: #0f0d24(0.95);
            Padding: (Left: 14, Right: 14, Top: 12, Bottom: 12);

          Label #StatsHeading {
            Text: "Atributos";
            Style: (FontSize: 14, TextColor: #cdbfff, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            Anchor: (Width: 532, Height: 26);
          }
          Group { Anchor: (Width: 532, Height: 1); Background: #4b3f94(0.9); }
          Group { Anchor: (Width: 10, Height: 8); }
          Group {
            LayoutMode: Left;
            Anchor: (Width: 532, Height: 92);

          Group #HealthCard {
            LayoutMode: Left;
            Anchor: (Width: 259, Height: 92);
            Background: #1b1842(0.97);

            Group #HealthAccent {
              Anchor: (Width: 5, Height: 92);
              Background: #ff6b6b;
            }

            Group #HealthBody {
              LayoutMode: Left;
              Anchor: (Width: 254, Height: 92);

              Group #HealthText {
                LayoutMode: Top;
                Anchor: (Width: 128, Height: 92);
                Padding: (Left: 12, Right: 4, Top: 6, Bottom: 4);

                Label #HealthLabel {
                  Text: "Health";
                  Style: (FontSize: 13, TextColor: #ff6b6b, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                  Anchor: (Width: 112, Height: 22);
                }
                Label #HealthValue {
                  Text: "0";
                  Style: (FontSize: 22, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 112, Height: 34);
                }
                Label #HealthDelta {
                  Text: "";
                  Style: (FontSize: 12, TextColor: #ffd166, RenderBold: true, VerticalAlignment: Center);
                  Anchor: (Width: 112, Height: 20);
                }
              }

              Group #HealthControls {
                LayoutMode: Top;
                Anchor: (Width: 126, Height: 92);

                Group { Anchor: (Width: 126, Height: 26); }

                Group #HealthButtons {
                  LayoutMode: Left;
                  Anchor: (Width: 126, Height: 40);

                  TextButton #HealthMinusBtn {
                    Anchor: (Width: 56, Height: 40);
                    Text: "-";
                    Style: $C.@DefaultTextButtonStyle;
                  }
                  Group #HealthMinusOff {
                    Visible: false;
                    Anchor: (Width: 56, Height: 40);
                    Background: #24214d(0.9);
                    Label #HealthMinusOffText {
                      Text: "-";
                      Style: (FontSize: 16, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                      Anchor: (Width: 56, Height: 40);
                    }
                  }
                  Group #HealthButtonGap {
                    Anchor: (Width: 8, Height: 40);
                  }
                  TextButton #HealthBtn {
                    Anchor: (Width: 56, Height: 40);
                    Text: "+";
                    Style: $C.@DefaultTextButtonStyle;
                  }
                  Group #HealthPlusOff {
                    Visible: false;
                    Anchor: (Width: 56, Height: 40);
                    Background: #24214d(0.9);
                    Label #HealthPlusOffText {
                      Text: "+";
                      Style: (FontSize: 16, TextColor: #5f5a80, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                      Anchor: (Width: 56, Height: 40);
                    }
                  }
                }
              }
            }
          }
            Group { Anchor: (Width: 14, Height: 92); }

          Group #ManaCard {
            LayoutMode: Left;
            Anchor: (Width: 259, Height: 92);
            Background: #1b1842(0.97);

            Group #ManaAccent {
              Anchor: (Width: 5, Height: 92);
              Background: #5aa9ff;
            }

            Group #ManaBody {
